(# Sliding window protocol \(Go-Back-N\) simulation) Tj
T*
(TOTAL, WINDOW = 8, 4) Tj
T*
(LOST = {3}                      # frame 3 is lost the first time it is sent) Tj
T*
T*
(base = nxt = 0) Tj
T*
(lost_once = set\(LOST\)) Tj
T*
(print\(f"Total frames = {TOTAL}, Window size = {WINDOW}\\n"\)) Tj
T*
(while base < TOTAL:) Tj
T*
(    while nxt < base + WINDOW and nxt < TOTAL:) Tj
T*
(        print\(f"Sender   : Frame {nxt} sent   window=[{base}..{min\(base+WINDOW,TOTAL\)-1}]"\)) Tj
T*
(        nxt += 1) Tj
T*
(    expected = base) Tj
T*
(    for f in range\(base, nxt\):) Tj
T*
(        if f in lost_once:) Tj
T*
(            print\(f"Network  : Frame {f} LOST"\)) Tj
T*
(            lost_once.discard\(f\)) Tj
T*
(            print\(f"Sender   : Timeout for frame {f}, resending from frame {f}"\)) Tj
T*
(            nxt = f) Tj
T*
(            break) Tj
T*
(        print\(f"Receiver : Frame {f} received, ACK {f + 1} sent"\)) Tj
T*
(        print\(f"Sender   : ACK {f + 1} received, window slides"\)) Tj
T*
(        base = f + 1) Tj
T*
(print\("\\nAll frames transmitted successfully."\)) Tj
T*
