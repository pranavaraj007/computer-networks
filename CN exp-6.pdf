(# Hamming \(7,4\) error detection and correction) Tj
T*
(def encode\(d\):                      # d = [d1, d2, d3, d4]) Tj
T*
(    d1, d2, d3, d4 = d) Tj
T*
(    p1 = d1 ^ d2 ^ d4) Tj
T*
(    p2 = d1 ^ d3 ^ d4) Tj
T*
(    p3 = d2 ^ d3 ^ d4) Tj
T*
(    return [p1, p2, d1, p3, d2, d3, d4]   # positions 1..7) Tj
T*
T*
(def decode\(c\):) Tj
T*
(    s1 = c[0] ^ c[2] ^ c[4] ^ c[6]) Tj
T*
(    s2 = c[1] ^ c[2] ^ c[5] ^ c[6]) Tj
T*
(    s3 = c[3] ^ c[4] ^ c[5] ^ c[6]) Tj
T*
(    pos = s3 * 4 + s2 * 2 + s1           # 0 means no error) Tj
T*
(    if pos != 0:) Tj
T*
(        c[pos - 1] ^= 1                  # correct the bit) Tj
T*
(    return pos, [c[2], c[4], c[5], c[6]]) Tj
T*
T*
(data = [int\(b\) for b in input\("Enter 4 data bits: "\)]) Tj
T*
(code = encode\(data\)) Tj
T*
(print\("Data bits        :", *data\)) Tj
T*
(print\("Hamming codeword :", *code\)) Tj
T*
T*
(recv = code[:]) Tj
T*
(p = int\(input\("Enter bit position \(1-7\) to corrupt, 0 for none: "\)\)) Tj
T*
(if p:) Tj
T*
(    recv[p - 1] ^= 1) Tj
T*
(print\("Received word    :", *recv\)) Tj
T*
T*
(pos, corrected = decode\(recv\)) Tj
T*
(if pos == 0:) Tj
T*
(    print\("No error detected."\)) Tj
T*
(else:) Tj
T*
(    print\("Error detected at position", pos\)) Tj
T*
(    print\("Corrected word   :", *recv\)) Tj
T*
(print\("Recovered data   :", *corrected\)) Tj
T*
(print\("Verification     :", "SUCCESS" if corrected == data else "FAILED"\)) Tj
T*
